# offensive-agency: site configuration template (Zeek Config framework).
#
# Copy this file somewhere outside the package (e.g. /etc/zeek/lbl.cfg),
# fill in your own values, and register it in local.zeek:
#
#     redef Config::config_files += { "/etc/zeek/lbl.cfg" };
#
# Edits take effect without a Zeek restart.
# Format: "<option><TAB><value>" (full Module::name, no '=' or ';');
# intervals in seconds; sets comma separated.
# The addresses below are RFC 5737 documentation placeholders: replace them.
#
# Every option is set in ONE config file only. The Config framework does not
# order files, so if a host cfg also sets an option below, either value may
# win.

# --- Feed --------------------------------------------------------------------
# Either let each manager fetch over HTTP (leave feed_file unset), or refresh
# a shared copy from cron with tools/fetch-feed.sh and point every cluster at it:
#OffensiveAgency::feed_file	/path/to/shared/offensive-agency/hosts.ndjson
OffensiveAgency::refresh_interval	1800
# ThreatDefence report-sourced IoCs, refreshed by tools/fetch-threatdefence.sh:
#OffensiveAgency::td_file	/path/to/shared/offensive-agency/threatdefence.tsv
# Fetch through a proxy (curl -x syntax):
#OffensiveAgency::fetch_proxy	http://proxy.example.org:3128
# state_dir is host-specific (must be writable by the Zeek user, and should
# survive restarts): set it in a host config file, not here.

# --- Noise controls ----------------------------------------------------------
OffensiveAgency::min_level	confirmed
OffensiveAgency::include_cdn_ips	F
OffensiveAgency::max_cloud_ip_age	259200

# Authorised scanners: their probes and OAST payloads must not page anyone.
OffensiveAgency::ignore_hosts	192.0.2.0/27,198.51.100.20/30

# --- Drops -------------------------------------------------------------------
# Tag inbound findings from external agent hosts with ACTION_DROP; your drop
# machinery (e.g. NetControl) carries it out. Off unless set to T.
OffensiveAgency::lbl_drop_inbound	F

# Never drop: your own address space, upstream routers, DR sites, CDNs you
# depend on, and so on.
OffensiveAgency::lbl_never_drop_nets	192.0.2.0/24,198.51.100.0/24,203.0.113.0/24
